FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /source
COPY Directory.Build.props ./
COPY src/RailBooking.Mock/ src/RailBooking.Mock/
RUN dotnet publish src/RailBooking.Mock -c Release -o /app
FROM mcr.microsoft.com/dotnet/aspnet:10.0
WORKDIR /app
COPY --from=build /app .
USER $APP_UID
ENV PORT=8082
EXPOSE 8082
ENTRYPOINT ["dotnet","RailBooking.Mock.dll"]
